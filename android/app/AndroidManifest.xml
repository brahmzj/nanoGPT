<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.morpheus"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- only used for look-ups, and only after you tap the globe to allow them -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- lets "set an alarm" / "remind me in 10 minutes" hand the job to your Clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- keeps the charging-only learning schedule after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- lets the background work wait for a network (Android 14 asks apps to say so) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- tells you when it finishes a task while you are away (Android 13+ asks you first) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ only lets apps talk to the text-to-speech engine if they say so -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:label="Morpheus"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share -> Morpheus: text or a link from any app, read at the next learning session -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- one quiet learning session every ~6 hours while charging, or now when you tap the brain -->
        <service
            android:name=".LearnJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- works on the tasks you give it (find out..., learn about...) until they are done -->
        <service
            android:name=".WorkJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
    </application>
</manifest>
